#: pretalx_release_hook/apps.py
msgid "pretalx Release Hook"
msgstr "pretalx Release Hook"

#: pretalx_release_hook/apps.py
msgid "Call a webhook when a schedule version is released."
msgstr "Rufe einen Webhook auf, wenn eine Programmversion veröffentlicht wird."

#: pretalx_release_hook/apps.py
msgid "Settings"
msgstr "Einstellungen"

#: pretalx_release_hook/forms.py
msgid "Header"
msgstr "Header"

#: pretalx_release_hook/forms.py
msgid "Enter a valid HTTP header name."
msgstr "Gib einen gültigen HTTP-Header-Namen ein."

#: pretalx_release_hook/forms.py pretalx_release_hook/models.py
msgid "Value"
msgstr "Wert"

#: pretalx_release_hook/forms.py
msgid "Enter a valid HTTP header value."
msgstr "Gib einen gültigen HTTP-Header-Wert ein."

#: pretalx_release_hook/forms.py
msgid "Use an HTTP or HTTPS URL. Leave empty to disable the hook."
msgstr "Verwende eine HTTP- oder HTTPS-URL. Lasse das Feld leer, um den Hook zu deaktivieren."

#: pretalx_release_hook/forms.py
#, python-brace-format
msgid ""
"GET ignores the payload. POST and PUT send this text as the body. Event mail "
"placeholders such as {event_slug} are supported."
msgstr ""
"GET ignoriert die Nutzdaten. POST und PUT senden diesen Text als Body. "
"Platzhalter aus E-Mail-Vorlagen wie {event_slug} werden unterstützt."

#: pretalx_release_hook/models.py
msgid "URL"
msgstr "URL"

#: pretalx_release_hook/models.py
msgid "Payload"
msgstr "Nutzdaten"

#: pretalx_release_hook/models.py
msgid "Name"
msgstr "Name"

#: pretalx_release_hook/payload.py
msgid "Unknown placeholder!"
msgstr "Unbekannter Platzhalter!"

#: pretalx_release_hook/payload.py
msgid "Select GET, POST, or PUT."
msgstr "Wähle GET, POST oder PUT aus."

#: pretalx_release_hook/signals.py
#: pretalx_release_hook/templates/pretalx_release_hook/settings.html
msgid "Release hook"
msgstr "Release hook"

#: pretalx_release_hook/templates/pretalx_release_hook/settings.html
msgid "HTTP Header"
msgstr "HTTP-Header"

#: pretalx_release_hook/templates/pretalx_release_hook/settings.html
msgid "Optional"
msgstr "Optional"

#: pretalx_release_hook/templates/pretalx_release_hook/settings.html
msgid "Delete"
msgstr "Löschen"

#: pretalx_release_hook/templates/pretalx_release_hook/settings.html
msgid "Save"
msgstr "Speichern"

#: pretalx_release_hook/views.py
msgid "Hook settings saved."
msgstr "Hook Einstellungen gespeichert."

#: pretalx_release_hook/views.py
#, python-brace-format
msgid "Rendered payload: {payload}"
msgstr "Gerenderte Nutzdaten: {payload}"
